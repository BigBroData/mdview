{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mdview",
  "version": "0.3.0",
  "identifier": "dev.mdview.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3737",
    "beforeDevCommand": "bun run start -- README.md --dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mdview",
        "width": 960,
        "height": 820,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' mdasset: http://mdasset.localhost data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Lightweight Markdown viewer",
    "longDescription": "Shows a Markdown file with math, tables, code highlighting and live reload.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "ext": ["mdx"],
        "name": "MDX",
        "mimeType": "text/mdx",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./mdview.desktop",
        "files": {
          "/usr/share/mime/packages/mdview.xml": "./mime/mdview.xml"
        }
      }
    }
  }
}
