{
  "name": "mdview",
  "version": "0.3.0",
  "description": "Lightweight, elegant Markdown viewer. Version 3: viewer and editor.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "BigBroData",
  "scripts": {
    "start": "bun run src/server/main.ts",
    "build": "bun run src/server/build.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x biome check .",
    "format": "bun x biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@vscode/markdown-it-katex": "1.1.2",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "latest",
    "@types/jsdom": "30.0.0",
    "jsdom": "30.1.3",
    "typescript": "^5"
  }
}
